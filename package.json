{
  "name": "kaliapp3",
  "version": "1.0.0",
  "description": "DSocial Calendar - Web + iOS App",
  "private": true,
  "scripts": {
    "dev": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "preview": "cd web && npm run preview",
    "lint": "cd web && npm run lint",
    "install:web": "cd web && npm install",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:sync": "npx cap sync ios",
    "ios:deploy": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:dev-setup": "bash scripts/setup-dev-server.sh",
    "ios:dev-sync": "npx cap sync ios --config capacitor.config.dev.local.ts",
    "ios:dev-open": "npx cap open ios",
    "ios:dev": "npm run ios:dev-setup && echo '\n✅ Configuration créée! Maintenant:\n1. Démarrez le serveur: npm run dev\n2. Synchronisez avec iOS: npm run ios:dev-sync\n3. Ouvrez Xcode: npm run ios:dev-open'"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  }
}
